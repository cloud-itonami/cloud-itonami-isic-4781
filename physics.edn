;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; This README has no "Robotics premise" section; the physical work is taken
;; from its scope: market-stall / street-market vendors of food, beverages
;; and tobacco (ISIC 4781). A robot at such a stall would unload produce
;; crates from the van onto the stall table and keep chilled food (fish,
;; meat, dairy) cold on the ice display during trading.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-4781"
 :cases
 [{:id :produce-crate-to-stall-table
   :kind :manipulator
   :procedure "arm lifts a produce crate from the van floor onto the stall table"
   :params {:l1-m 0.55 :l2-m 0.50 :m1-kg 5.0 :m2-kg 3.5
            :from [0.60 -0.10] :to [0.75 0.35] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [5.0 8.0 12.0 16.0 20.0]}
   :quantity :peak-tau1-nm
   :limit {:max 120.0 :basis "estimate: continuous shoulder torque of a ~10 kg-payload collaborative arm"}
   :boundary {:lo 0.5 :hi 60.0}}
  {:id :chilled-fillet-on-ice-display
   :kind :thermal
   :procedure "a 3 cm fish fillet lies on the crushed-ice display for a 2 h trading window; top face in stall air, bottom face on ice"
   :params {:thickness-m 0.03 :conductivity-w-mk 0.50 :density-kg-m3 1050.0 :specific-heat-j-kgk 3600.0
            :t0-c 2.0 :h-front-w-m2k 10.0 :t-back-ambient-c 0.0 :h-back-w-m2k 200.0
            :duration-s 7200.0 :nodes 21 :threshold-c 5.0}
   :sweep {:param :t-hot-c :values [10.0 15.0 20.0 25.0 30.0 35.0]}
   :quantity :final-front-c
   :limit {:max 5.0 :basis "US FDA Food Code 2022 3-501.16(A)(2): TCS food held cold at 5 C (41 F) or less; judged at the warmest point (the exposed surface). Fillet properties, h and the ice contact are estimates"}
   :boundary {:lo 5.0 :hi 40.0}}]}
